# Navigation {{{
keymap j  UP
keymap k  DOWN
keymap h  LEFT
keymap l  RIGHT
keymap w    NEXT_WORD
keymap b    PREV_WORD
keymap C-d  NEXT_HALF_PAGE
keymap C-u  PREV_HALF_PAGE
keymap C-f  NEXT_PAGE
keymap C-b  PREV_PAGE
keymap zh   CENTER_H
keymap zz   CENTER_V
keymap C-g  LINE_INFO
keymap 0    LINE_BEGIN
keymap $    LINE_END
keymap gg   BEGIN
keymap G    END
keymap u  UNDO
keymap C-r  REDO
keymap /    ISEARCH
keymap ?    ISEARCH_BACK
keymap N    SEARCH_PREV
keymap n    SEARCH_NEXT
# }}}

# Buffer operations {{{
keymap H    PREV
keymap L    NEXT
keymap SPC-SPC SELECT_MENU
keymap c    PEEK
keymap U    GOTO
keymap C-u  GOTO_RELATIVE
keymap R  RELOAD
keymap SPC-w EXTERN

keymap v    VIEW # View source
keymap :e   LOAD # Open local file
keymap e    EDIT_SCREEN # Edit text
keymap E    EDIT # Edit source 
keymap :w    SAVE_SCREEN # Save buffer (text)
keymap C-S   SAVE # Save html (source)
# }}}

# Tab operations {{{
keymap C-t   NEW_TAB
keymap x    CLOSE_TAB
keymap J    PREV_TAB
keymap K    NEXT_TAB
keymap <    TAB_LEFT
keymap >    TAB_RIGHT
# }}}

# Links {{{
keymap u    PEEK_LINK
keymap SPC-l  LIST_MENU
keymap C-n  NEXT_LINK
keymap C-p  PREV_LINK
keymap [    LINK_BEGIN
keymap ]    LINK_END
keymap t    TAB_LINK
keymap yy   EXTERN 'printf %s | wl-copy' # yank url

keymap i    PEEK_IMG
keymap I    VIEW_IMAGE 
keymap SPC-I SAVE_IMAGE
# }}}

# Macros {{{
keymap o COMMAND "SET_OPTION dictcommand=file:///cgi-bin/omnibar.cgi ; DICT_WORD"
keymap O COMMAND "SET_OPTION dictcommand=file:///cgi-bin/omnibar-tab.cgi ; DICT_WORD"
# Link hinting
keymap SPC-f   COMMAND "SET_OPTION display_link_number=toggle ; RESHAPE"
keymap f       COMMAND "SET_OPTION display_link_number=0 ; RESHAPE ; LINK_BEGIN ; GOTO_LINK"
keymap F       COMMAND "SET_OPTION display_link_number=0 ; RESHAPE ; LINK_BEGIN ; TAB_LINK"
keymap yf      COMMAND "SET_OPTION display_link_number=0 ; RESHAPE ; LINK_BEGIN ; EXTERN_LINK 'printf '%s' | wl-copy 2>/dev/null'"
# }}}

# Misc {{{
keymap !    SHELL
keymap SPC-h HISTORY
keymap SPC-o OPTIONS
keymap SPC-m MENU # Optionally configurable (~/.config/w3m/menu)
keymap SPC-x INFO # page info, including the response HTTP header
keymap SPC-w WRAP_TOGGLE
keymap SPC-b       SHELL "~/.local/bin/bookmark"
keymap SPC-sc      SHELL "$EDITOR ~/.config/w3m/config"
keymap SPC-sk      SHELL "$EDITOR ~/.config/w3m/keymap"
# }}}
