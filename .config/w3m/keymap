# Navigation {{{
keymap j  UP
keymap k  DOWN
keymap h  LEFT
keymap l  RIGHT
keymap w    NEXT_WORD
keymap b    PREV_WORD
keymap C-d  NEXT_HALF_PAGE
keymap C-u  PREV_HALF_PAGE
keymap C-f  NEXT_PAGE
keymap C-b  PREV_PAGE
keymap zh   CENTER_H
keymap zz   CENTER_V
keymap C-g  LINE_INFO
keymap 0    LINE_BEGIN
keymap $    LINE_END
keymap gg   BEGIN
keymap G    END
keymap u    UNDO
keymap C-r  REDO
keymap /    ISEARCH
keymap ?    ISEARCH_BACK
keymap N    SEARCH_PREV
keymap n    SEARCH_NEXT
# }}}

# Buffer operations {{{
keymap H    PREV
keymap L    NEXT
keymap SPC-SPC SELECT_MENU
keymap c    PEEK
keymap U    GOTO
keymap C-u  GOTO_RELATIVE
keymap R  RELOAD
keymap SPC-w EXTERN

# view source
keymap v    VIEW 
keymap :e   LOAD
keymap e    EDIT_SCREEN 
#keymap C-e  EDIT 
keymap :w   SAVE_SCREEN
keymap C-s  SAVE
keymap Esc-y EXTERN 'printf %s | wl-copy'
keymap Esc-b EXTERN 'printf %s >> ~/.local/share/bookmarks'
# }}}

# Tabs {{{
keymap C-t   NEW_TAB
keymap X    CLOSE_TAB
keymap J    PREV_TAB
keymap K    NEXT_TAB
keymap <    TAB_LEFT
keymap >    TAB_RIGHT
# }}}

# Links {{{
keymap u    PEEK_LINK
keymap SPC-l  LIST_MENU
keymap C-n  NEXT_LINK
keymap C-p  PREV_LINK
keymap [    LINK_BEGIN
keymap ]    LINK_END
keymap t    TAB_LINK
keymap yy  EXTERN_LINK 'printf %s | wl-copy'
keymap b   EXTERN_LINK 'printf %s >> ~/.local/share/bookmarks'
keymap xw  EXTERN_LINK
#images
keymap i  NEXT_IMAGE
keymap I  PREV_IMAGE
keymap C-i    VIEW_IMAGE 
keymap SPC-I SAVE_IMAGE
# }}}
 
# Misc {{{
keymap SPC-o OPTIONS
keymap SPC-h HELP
keymap SPC-x INFO
keymap SPC-r REINIT
keymap SPC-w EXTERN
keymap SPC-b SHELL "$EDITOR ~/.local/share/bookmarks"
keymap SPC-c SHELL "$EDITOR ~/.config/w3m/config"
keymap SPC-k SHELL "$EDITOR ~/.config/w3m/keymap"
keymap xb    SHELL "~/.local/bin/bookmark"

keymap o COMMAND "SET_OPTION dictcommand=file:///cgi-bin/omnibar.cgi ; DICT_WORD"
keymap O COMMAND "SET_OPTION dictcommand=file:///cgi-bin/omnibar-tab.cgi ; DICT_WORD"
# Link hinting
keymap SPC-f   COMMAND "SET_OPTION display_link_number=toggle ; RESHAPE"
keymap f       COMMAND "SET_OPTION display_link_number=0 ; RESHAPE ; LINK_BEGIN ; GOTO_LINK"
keymap F       COMMAND "SET_OPTION display_link_number=0 ; RESHAPE ; LINK_BEGIN ; TAB_LINK"
keymap yf      COMMAND "SET_OPTION display_link_number=0 ; RESHAPE ; LINK_BEGIN ; EXTERN_LINK 'printf %s | wl-copy 2>/dev/null'"
# }}}
