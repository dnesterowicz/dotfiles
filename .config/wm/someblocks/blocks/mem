#/bin/sh

# mem usage in MB
usage=$(awk '/^MemTotal:/ {total=$2} /^MemFree:/ {free=$2} /^Buffers:/ {buffers=$2} /^Cached:/ {cached=$2} END {print(total - free - buffers - cached)/1024}' /proc/meminfo)

if [ $(echo "$usage >= 1024.0" | bc) -eq "1" ]; then
  in_GB=$(echo "$usage / 1024.0" | bc -l)
  printf "%.1fGB" $in_GB
else
  printf "%dMB" $usage
fi

